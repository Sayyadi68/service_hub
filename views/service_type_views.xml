<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======== Form View ======== -->
        <record id="view_service_type_form" model="ir.ui.view">
            <field name="name">service.type.form</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <form string="نوع خدمت">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="مثلاً: نصب و راه‌اندازی"/>
                            </h1>
                        </div>
                        <group>
                            <group string="اطلاعات خدمت">
                                <field name="description"/>
                                <field name="duration" widget="float_time"/>
                            </group>
                            <group string="قیمت‌گذاری">
                                <field name="base_price"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======== List (Tree) View ======== -->
        <record id="view_service_type_list" model="ir.ui.view">
            <field name="name">service.type.list</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <tree string="انواع خدمات" editable="bottom" sample="1">
                    <field name="name"/>
                    <field name="base_price"/>
                    <field name="duration" widget="float_time"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- ======== Kanban View ======== -->
        <record id="view_service_type_kanban" model="ir.ui.view">
            <field name="name">service.type.kanban</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <kanban sample="1">
                    <field name="name"/>
                    <field name="base_price"/>
                    <field name="duration"/>
                    <field name="description"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="#{!selection_mode ? 'oe_kanban_global_click' : ''}">
                                <div class="o_kanban_record_body">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="description"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="base_price"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right text-muted">
                                        <small>
                                            مدت: <field name="duration"/> ساعت
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ======== Search View ======== -->
        <record id="view_service_type_search" model="ir.ui.view">
            <field name="name">service.type.search</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <search string="جستجوی نوع خدمت">
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                    <filter string="فعال" name="active" domain="[('active', '=', True)]"/>
                    <filter string="غیرفعال" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="گروه‌بندی">
                        <filter string="وضعیت" name="group_active" domain="[]" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ======== Action ======== -->
        <record id="action_service_type" model="ir.actions.act_window">
            <field name="name">انواع خدمات</field>
            <field name="res_model">service.type</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="view_id" ref="view_service_type_list"/>
            <field name="search_view_id" ref="view_service_type_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    هنوز نوع خدمتی تعریف نشده است
                </p>
                <p>
                    انواع خدماتی که شرکت ارائه می‌دهد را با قیمت پایه و مدت تقریبی تعریف کنید.
                </p>
            </field>
        </record>

    </data>
</odoo>
