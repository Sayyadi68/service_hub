<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ======== Form View ======== -->
        <record id="view_service_order_form" model="ir.ui.view">
            <field name="name">service.order.form</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <form string="سفارش خدمت">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="اطلاعات سفارش">
                                <field name="request_id" options="{'no_create': True}"/>
                                <field name="customer_id"/>
                                <field name="service_type_id"/>
                                <field name="technician_id" widget="many2one_avatar_user"/>
                                <field name="priority" widget="priority"/>
                                <field name="amount"/>
                            </group>
                            <group string="زمان‌بندی">
                                <field name="date_order"/>
                                <field name="color" widget="color_picker" string="رنگ"/>
                            </group>
                        </group>
                        <group string="یادداشت">
                            <field name="notes" nolabel="1" placeholder="یادداشت داخلی..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======== List (Tree) View ======== -->
        <record id="view_service_order_list" model="ir.ui.view">
            <field name="name">service.order.list</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <tree string="سفارش‌های خدمت" multi_edit="1" sample="1"
                      decoration-info="priority == '1'"
                      decoration-warning="priority == '2'"
                      decoration-danger="priority == '3'">
                    <field name="name" decoration-bf="1"/>
                    <field name="request_id"/>
                    <field name="customer_id" widget="many2one_avatar_partner"/>
                    <field name="service_type_id"/>
                    <field name="technician_id" widget="many2one_avatar_user"/>
                    <field name="priority" widget="priority"/>
                    <field name="amount" sum="جمع کل"/>
                    <field name="date_order" optional="show"/>
                </tree>
            </field>
        </record>

        <!-- ======== Search View ======== -->
        <record id="view_service_order_search" model="ir.ui.view">
            <field name="name">service.order.search</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <search string="جستجوی سفارش">
                    <field name="name" string="سفارش" filter_domain="['|', ('name', 'ilike', self), ('request_id', 'ilike', self)]"/>
                    <field name="customer_id"/>
                    <field name="technician_id"/>
                    <field name="service_type_id"/>
                    <filter string="سفارش‌های من" name="my_orders" domain="[('technician_id', '=', uid)]"/>
                    <separator/>
                    <filter string="مهم" name="important" domain="[('priority', 'in', ('2', '3'))]"/>
                    <filter string="فوری" name="urgent" domain="[('priority', '=', '3')]"/>
                    <separator/>
                    <filter string="این ماه" name="this_month" date="date_order"/>
                    <group expand="0" string="گروه‌بندی">
                        <filter string="مشتری" name="group_customer" domain="[]" context="{'group_by': 'customer_id'}"/>
                        <filter string="تکنسین" name="group_technician" domain="[]" context="{'group_by': 'technician_id'}"/>
                        <filter string="نوع خدمت" name="group_service_type" domain="[]" context="{'group_by': 'service_type_id'}"/>
                        <filter string="اولویت" name="group_priority" domain="[]" context="{'group_by': 'priority'}"/>
                        <filter string="تاریخ سفارش" name="group_date" domain="[]" context="{'group_by': 'date_order'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ======== Kanban View ======== -->
        <record id="view_service_order_kanban" model="ir.ui.view">
            <field name="name">service.order.kanban</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="priority" class="o_kanban_small_column" sample="1">
                    <field name="name"/>
                    <field name="request_id"/>
                    <field name="customer_id"/>
                    <field name="service_type_id"/>
                    <field name="technician_id"/>
                    <field name="priority"/>
                    <field name="amount"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle text-muted">
                                            <field name="customer_id"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="service_type_id"/>
                                    <br/>
                                    <field name="request_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="amount"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="technician_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ======== Calendar View ======== -->
        <record id="view_service_order_calendar" model="ir.ui.view">
            <field name="name">service.order.calendar</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <calendar string="سفارش‌های خدمت" date_start="date_order" color="service_type_id" mode="month" event_open_popup="true">
                    <field name="name"/>
                    <field name="customer_id"/>
                </calendar>
            </field>
        </record>

        <!-- ======== Pivot View ======== -->
        <record id="view_service_order_pivot" model="ir.ui.view">
            <field name="name">service.order.pivot</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <pivot string="تحلیل سفارش‌ها" sample="1">
                    <field name="service_type_id" type="row"/>
                    <field name="date_order" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ======== Graph View ======== -->
        <record id="view_service_order_graph" model="ir.ui.view">
            <field name="name">service.order.graph</field>
            <field name="model">service.order</field>
            <field name="arch" type="xml">
                <graph string="نمودار سفارش‌ها" sample="1">
                    <field name="service_type_id"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ======== Action ======== -->
        <record id="action_service_order" model="ir.actions.act_window">
            <field name="name">سفارش‌ها</field>
            <field name="res_model">service.order</field>
            <field name="view_mode">kanban,tree,form,calendar,pivot,graph</field>
            <field name="search_view_id" ref="view_service_order_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    هیچ سفارشی ثبت نشده است
                </p>
                <p>
                    با ایجاد اولین سفارش خدمت شروع کنید؛ سفارش‌ها از درخواست‌های تأیید شده ساخته می‌شوند.
                </p>
            </field>
        </record>

        <record id="action_service_order_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="act_window_id" ref="action_service_order"/>
            <field name="view_id" ref="view_service_order_kanban"/>
        </record>
        <record id="action_service_order_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">tree</field>
            <field name="act_window_id" ref="action_service_order"/>
            <field name="view_id" ref="view_service_order_list"/>
        </record>
        <record id="action_service_order_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="act_window_id" ref="action_service_order"/>
            <field name="view_id" ref="view_service_order_form"/>
        </record>
        <record id="action_service_order_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="4"/>
            <field name="view_mode">calendar</field>
            <field name="act_window_id" ref="action_service_order"/>
            <field name="view_id" ref="view_service_order_calendar"/>
        </record>
        <record id="action_service_order_view_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="5"/>
            <field name="view_mode">pivot</field>
            <field name="act_window_id" ref="action_service_order"/>
            <field name="view_id" ref="view_service_order_pivot"/>
        </record>
        <record id="action_service_order_view_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="6"/>
            <field name="view_mode">graph</field>
            <field name="act_window_id" ref="action_service_order"/>
            <field name="view_id" ref="view_service_order_graph"/>
        </record>

    </data>
</odoo>
